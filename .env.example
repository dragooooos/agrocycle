# Optional API keys for the local data proxy (vite.config.ts).
# Copy this file to .env, fill in the keys and restart `npm run dev`.
# The keys stay on the dev server and are never sent to the browser.

# USDA NASS Quick Stats – free key: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# OpenET – free account + key: https://etdata.org/api/
OPENET_API_KEY=
